          "functionId": "ee95afe8-ea2c-409f-80bc-f072dae5fb7e",
          "title": "Clone Balance",
          "description": "",
          "className": "SetMultiFieldsFunction",
          "parameters": {
            "statePath": {
              "@type": "statevariable",
              "value": "newBalance"
            },
            "lookups": {
              "@type": "keyvaluelookup",
              "value": {
                "accountId": {
                  "@type": "lookup",
                  "value": "m3Balance.accountId",
                  "lookupType": "STATE_PATH"
                },
                "lineItemTypes": {
                  "@type": "lookup",
                  "value": "m3Balance.lineItemTypes",
                  "lookupType": "STATE_PATH"
                },
                "productIds": {
                  "@type": "lookup",
                  "value": "m3Balance.productIds",
                  "lookupType": "STATE_PATH"
                },
                "currency": {
                  "@type": "lookup",
                  "value": "m3Balance.currency",
                  "lookupType": "STATE_PATH"
                },
                "startDate": {
                  "@type": "lookup",
                  "value": "DateTime.dateAdd(m3BalanceResponse.startDate, Number(acc) + 1, \"MONTHS\") ",
                  "lookupType": "CALCULATION"
                },
                "endDate": {
                  "@type": "lookup",
                  "value": "DateTime.dateAdd(m3BalanceResponse.endDate, Number(acc) + 1, \"MONTHS\") ",
                  "lookupType": "CALCULATION"
                },
                "name": {
                  "@type": "lookup",
                  "value": "String.replace(m3Balance.name, DateTime.dateFormat( m3BalanceResponse.startDate , \"MMMM\"), DateTime.dateFormat( DateTime.dateAdd(m3BalanceResponse.startDate, Number(acc) + 1, \"MONTHS\") , \"MMMM\") )",
                  "lookupType": "CALCULATION"
                },
                "code": {
                  "@type": "lookup",
                  "value": "m3Balance.code +  acc",
                  "lookupType": "CALCULATION"
                }
              }
            }
          },
          "exits": {
            "NEXT": "7a5b44f8-cec4-4b37-92ab-6dd20ed4f848"
          }
        },
