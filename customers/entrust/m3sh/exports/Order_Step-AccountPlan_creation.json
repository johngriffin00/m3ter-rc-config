                  "@type": "lookup",
                  "value": "sfAsset.LifecycleStartDate",
                  "lookupType": "STATE_PATH"
                },
                "endDate": {
                  "@type": "lookup",
                  "value": "DateTime.dateAdd(String.left( sfAsset.LifecycleEndDate, 22) + \"Z\", 1, \"SECONDS\")\n",
                  "lookupType": "CALCULATION"
                },
                "customFields.TUEId": {
                  "@type": "lookup",
                  "value": "sfTransactionUsageEntitlement.Id",
                  "lookupType": "STATE_PATH"
                },
                "code": {
                  "@type": "lookup",
                  "value": "sfTransactionUsageEntitlement.Id + \"-\" + m3Plan.code",
                  "lookupType": "CALCULATION"
                },
                "customFields.UEBId": {
                  "@type": "lookup",
                  "value": "tmpUEB.Id",
                  "lookupType": "STATE_PATH"
                }
              }
            }
          },
          "exits": {
            "NEXT": "9effadfa-bfcc-4d5a-9c0a-7aa8c39ba2d7"
