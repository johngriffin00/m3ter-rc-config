                  "value": "m3Plan.id",
                  "lookupType": "STATE_PATH"
                },
                "accountId": {
                  "@type": "lookup",
                  "value": "m3AccountId",
                  "lookupType": "STATE_PATH"
                },
                "customFields.AssetId": {
                  "@type": "lookup",
