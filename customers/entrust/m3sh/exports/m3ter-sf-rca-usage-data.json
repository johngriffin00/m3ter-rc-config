            "soqlQuery": {
              "@type": "string",
              "value": "SELECT Id, EffectiveStartDateTime, EffectiveEndDateTime FROM UsageEntitlementBucket WHERE TransactionUsageEntitlement.AccountId = '{{salesforceAccountId}}' AND Parent.Type = 'UsageEntitlementBucket'  AND BucketBalanceUoMId = '{{currentAccountPlan.customFields.EntitlemntUomId}}'  AND TransactionUsageEntitlementId = '{{currentAccountPlan.customFields.TUEId}}'"
