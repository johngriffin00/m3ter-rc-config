{
  "_comment": "The Verification Catalog itself was built by hand on 2026-10-06 and is only looked up. Its four categories and the 14 product placements are owned here.",
  "objects": [
    {
      "sobject": "ProductCatalog",
      "match_fields": [
        "Code"
      ],
      "records": [
        {
          "@id": "CAT_Verification",
          "@lookup-only": true,
          "Code": "CAT-VERIFICATION"
        }
      ]
    },
    {
